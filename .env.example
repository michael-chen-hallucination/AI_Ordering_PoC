# AWS Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=your-bedrock-model-id

# Speech recognition
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
SILENCE_SECONDS=1.0

# Downstream order service
ORDER_API_URL=https://orders.example.com/v1/orders
ORDER_API_TOKEN=replace-with-a-development-token
REQUEST_TIMEOUT_SECONDS=10.0

# Public URL exposed to Twilio. Leave blank to derive it from the request host.
PUBLIC_WEBSOCKET_URL=wss://your-public-host.example.com/media

# Application
LOG_LEVEL=INFO
MENU_JSON='{"Coke":"2.00","Chicken Sandwich":"4.51","Hamburger":"5.29"}'
